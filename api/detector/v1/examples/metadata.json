{
  "protocol_version": "1.0",
  "detector": {
    "id": "prompt-injection-mini",
    "version": "3.1.0",
    "revision": "sha256:detector-example-revision",
    "model": {
      "name": "example/model-name",
      "revision": "sha256:model-example-revision"
    }
  },
  "preprocessing_revision": "sha256:preprocessing-example-revision",
  "supported_stages": ["pre_model", "post_retrieval"],
  "supported_content_types": ["messages", "text"],
  "supported_languages": ["en"],
  "limits": {
    "max_batch_size": 16,
    "max_input_bytes": 262144
  },
  "taxonomy": [
    {
      "category": "prompt_injection",
      "description": "Instruction override or prompt-injection indicator."
    }
  ],
  "capabilities": {
    "spans": true,
    "batch": true,
    "deterministic": false
  },
  "recommended_thresholds": {
    "prompt_injection": 0.85
  }
}
