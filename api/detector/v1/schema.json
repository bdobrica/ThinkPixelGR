{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thinkpixel.dev/contracts/guardrails/detector/v1/schema.json",
  "title": "ThinkPixelGR remote detector protocol v1",
  "$defs": {
    "Stage": {
      "type": "string",
      "enum": ["pre_request", "pre_model", "post_model", "pre_tool", "post_tool", "pre_retrieval", "post_retrieval", "ingestion"]
    },
    "Message": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "content": {"type": "string"}
      },
      "additionalProperties": false
    },
    "Content": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "messages": {
          "type": "array",
          "items": {"$ref": "#/$defs/Message"}
        },
        "data": {"type": "object"}
      },
      "anyOf": [
        {"required": ["text"]},
        {"required": ["messages"]},
        {"required": ["data"]}
      ],
      "additionalProperties": false
    },
    "RequestMetadata": {
      "type": "object",
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1},
        "trace_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "DetectionRequest": {
      "type": "object",
      "required": ["request_id", "evaluation_id", "stage", "content"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "evaluation_id": {"type": "string", "minLength": 1},
        "stage": {"$ref": "#/$defs/Stage"},
        "content": {"$ref": "#/$defs/Content"},
        "configuration": {"type": "object"},
        "metadata": {"$ref": "#/$defs/RequestMetadata"}
      },
      "additionalProperties": false
    },
    "DetectorIdentity": {
      "type": "object",
      "required": ["id", "version", "revision", "model"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "model": {
          "type": ["object", "null"],
          "required": ["name", "revision"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Location": {
      "type": "object",
      "required": ["path", "start", "end"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "required": ["category", "confidence"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
        "locations": {
          "type": "array",
          "items": {"$ref": "#/$defs/Location"}
        },
        "attributes": {"type": "object"}
      },
      "additionalProperties": false
    },
    "Timing": {
      "type": "object",
      "required": ["total_ms"],
      "properties": {
        "total_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "DetectionResponse": {
      "type": "object",
      "required": ["request_id", "evaluation_id", "detector", "findings", "timing"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "evaluation_id": {"type": "string", "minLength": 1},
        "detector": {"$ref": "#/$defs/DetectorIdentity"},
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/Finding"}
        },
        "timing": {"$ref": "#/$defs/Timing"}
      },
      "additionalProperties": false
    },
    "BatchDetectionRequest": {
      "type": "object",
      "required": ["requests"],
      "properties": {
        "requests": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/DetectionRequest"}
        }
      },
      "additionalProperties": false
    },
    "BatchDetectionResponse": {
      "type": "object",
      "required": ["responses"],
      "properties": {
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/DetectionResponse"}
        }
      },
      "additionalProperties": false
    },
    "TaxonomyEntry": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "DetectorMetadata": {
      "type": "object",
      "required": ["protocol_version", "detector", "preprocessing_revision", "supported_stages", "supported_content_types", "supported_languages", "limits", "taxonomy", "capabilities", "recommended_thresholds"],
      "properties": {
        "protocol_version": {"const": "1.0"},
        "detector": {"$ref": "#/$defs/DetectorIdentity"},
        "preprocessing_revision": {"type": "string", "minLength": 1},
        "supported_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Stage"}
        },
        "supported_content_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "supported_languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "limits": {
          "type": "object",
          "required": ["max_batch_size", "max_input_bytes"],
          "properties": {
            "max_batch_size": {"type": "integer", "minimum": 0},
            "max_input_bytes": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "taxonomy": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/TaxonomyEntry"}
        },
        "capabilities": {
          "type": "object",
          "required": ["spans", "batch", "deterministic"],
          "properties": {
            "spans": {"type": "boolean"},
            "batch": {"type": "boolean"},
            "deterministic": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "recommended_thresholds": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capabilities": {
                "properties": {"batch": {"const": false}},
                "required": ["batch"]
              }
            }
          },
          "then": {
            "properties": {
              "limits": {
                "properties": {"max_batch_size": {"const": 0}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "properties": {"batch": {"const": true}},
                "required": ["batch"]
              }
            }
          },
          "then": {
            "properties": {
              "limits": {
                "properties": {"max_batch_size": {"minimum": 1}}
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "Health": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["ok", "not_ready"]}
      },
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {
              "type": "string",
              "enum": ["INVALID_REQUEST", "REQUEST_TOO_LARGE", "UNSUPPORTED_STAGE", "UNSUPPORTED_CONTENT_TYPE", "UNSUPPORTED_OPERATION", "OVERLOADED", "INTERNAL_ERROR"]
            },
            "message": {"type": "string", "minLength": 1},
            "retryable": {"type": "boolean"},
            "request_id": {"type": "string", "minLength": 1},
            "evaluation_id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
